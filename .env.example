# ============================================================
# Zovark — Environment Variables Template
#
# 1. Copy this file to `.env` (gitignored).
# 2. Replace every REPLACE_ME_* placeholder with a real value.
# 3. Every credential below is REQUIRED — compose and Pydantic
#    both fail-fast on missing values (stabilize-runtime-hygiene).
#
# Generate secrets with:
#   openssl rand -base64 32    # 32-char random string
#   openssl rand -base64 64    # for JWT_SECRET (≥64 chars)
#   openssl rand -hex  32      # for bearer tokens
#   htpasswd -nbBC 12 "" 'PLAINTEXT' | cut -d: -f2   # bcrypt hash
# ============================================================


# ─── DATABASE ───────────────────────────────────────────────
POSTGRES_USER=zovark
POSTGRES_PASSWORD=REPLACE_ME_openssl_rand_base64_32
POSTGRES_DB=zovark
# Pydantic Settings mirror (worker reads ZOVARK_-prefixed vars).
# Leave identical to POSTGRES_PASSWORD unless running a separate worker creds.
ZOVARK_DB_PASSWORD=REPLACE_ME_openssl_rand_base64_32


# ─── CACHE (Valkey / Redis) ─────────────────────────────────
REDIS_PASSWORD=REPLACE_ME_openssl_rand_base64_32
ZOVARK_REDIS_PASSWORD=REPLACE_ME_openssl_rand_base64_32


# ─── AUTH ───────────────────────────────────────────────────
# JWT signing secret (≥32 chars mandatory). Generate with:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_ME_openssl_rand_base64_64

# Bearer token for /diag/* sidecar endpoints. Generate with:
#   openssl rand -hex 32
DIAG_AUTH_TOKEN=REPLACE_ME_openssl_rand_hex_32

# Bcrypt hash of the break-glass admin password. Generate with:
#   htpasswd -nbBC 12 "" 'PLAINTEXT' | cut -d: -f2
# Required only if break-glass access is enabled.
ZOVARK_BREAKGLASS_PASSWORD_HASH=


# ─── LLM ────────────────────────────────────────────────────
# Cloud (OpenAI) is the default; set OPENAI_API_KEY from platform.openai.com.
# For air-gap / local llama.cpp, set ZOVARK_LLM_PROVIDER=local and override the endpoints.
OPENAI_API_KEY=REPLACE_ME_sk-openai-api-key
# Pydantic bearer token used by local/air-gap inference and fallback paths.
# REQUIRED even when OPENAI_API_KEY is set (the centralized loader pulls this
# for every worker-side LLM call after stabilize-runtime-hygiene).
ZOVARK_LLM_KEY=REPLACE_ME_bearer_for_local_inference

ZOVARK_LLM_PROVIDER=openai
ZOVARK_LLM_BASE_URL=https://api.openai.com
ZOVARK_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
ZOVARK_LLM_ENDPOINT_FAST=https://api.openai.com/v1/chat/completions
ZOVARK_LLM_ENDPOINT_CODE=https://api.openai.com/v1/chat/completions

# Air-gap / local llama-server example (uncomment + point at container):
# ZOVARK_LLM_PROVIDER=local
# ZOVARK_LLM_ENDPOINT=http://zovark-inference:8080/v1/chat/completions
# ZOVARK_LLM_ENDPOINT_FAST=http://zovark-inference:8080/v1/chat/completions
# ZOVARK_LLM_ENDPOINT_CODE=http://zovark-inference:8080/v1/chat/completions

# Model routing (two-role architecture)
ZOVARK_MODEL_FAST=gpt-4o-mini
ZOVARK_MODEL_CODE=gpt-4o-mini


# ─── INFERENCE CONTAINER (llama.cpp build) ─────────────────
# GPU tier: dev (single) or enterprise (dual). Only relevant if using
# docker-compose.distroless.yml / enterprise.yml overlays.
ZOVARK_GPU_TIER=dev
# CUDA compute capability for llama.cpp build: 75=Turing, 86=Ampere, 89=Ada, 90=Hopper
CUDA_ARCH=86

# Dev-tier model file (single container)
ZOVARK_MODEL_FILE=llama-3.2-3b-instruct.Q4_K_M.gguf
ZOVARK_MODEL_ALIAS=llama3.2:3b
ZOVARK_CTX_SIZE=4096
ZOVARK_PARALLEL=4

# Enterprise-tier (dual FAST/CODE containers) — uncomment if used
# ZOVARK_MODEL_FILE_FAST=llama-3.2-3b-instruct.Q4_K_M.gguf
# ZOVARK_MODEL_ALIAS_FAST=llama3.2:3b
# ZOVARK_CTX_SIZE_FAST=4096
# ZOVARK_MODEL_FILE_CODE=llama-3.1-8b-instruct.Q4_K_M.gguf
# ZOVARK_MODEL_ALIAS_CODE=llama3.1:8b
# ZOVARK_CTX_SIZE_CODE=8192


# ─── EXECUTION + CONCURRENCY ────────────────────────────────
ZOVARK_EXECUTION_MODE=tools           # tools (v3) or sandbox (v2 legacy)
ZOVARK_MODE=full                      # full or templates-only
ZOVARK_FAST_FILL=true
ZOVARK_MAX_CONCURRENT_ACTIVITIES=16
ZOVARK_MAX_CONCURRENT_WORKFLOWS=32
ZOVARK_CONTEXT_TOKEN_BUDGET=12000
ZOVARK_THREAT_INTEL_ENABLED=false


# ─── BURST PROTECTION ──────────────────────────────────────
ZOVARK_BATCH_WINDOW_SECONDS=60
ZOVARK_BATCH_MAX_SIZE=500
ZOVARK_CB_YELLOW=50
ZOVARK_CB_RED=100
ZOVARK_CB_RECOVERY=25
ZOVARK_ASSESS_TIMEOUT=45
ZOVARK_HUMAN_REVIEW_THRESHOLD=60
ZOVARK_CODE_CACHE_TTL=86400
DEDUP_ENABLED=true


# ─── OBSERVABILITY (OpenTelemetry → Signoz) ────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://zovark-signoz-collector:4318
ZOVARK_OTEL_ENDPOINT=http://zovark-signoz-collector:4318


# ─── UPDATE SIGNING ────────────────────────────────────────
# Ed25519 public key used to verify .zvk update bundles. See docs/AIRGAP_UPDATES.md
ZOVARK_UPDATE_PUBLIC_KEY_PATH=./keys/update-verify.pub


# ─── OPTIONAL DATA PLANE (SurrealDB / Redpanda / DuckDB) ───
# Enable via: docker compose -f docker-compose.yml -f docker-compose.data-plane.yml --profile data-plane up -d
# Uncomment and populate when enabling:
# SURREAL_ROOT_PASSWORD=REPLACE_ME_openssl_rand_base64_32
# ZOVARK_SURREAL_ENABLED=true
# ZOVARK_SURREAL_HTTP_URL=http://surrealdb:8000
# ZOVARK_SURREAL_USER=root
# ZOVARK_SURREAL_PASSWORD=REPLACE_ME_openssl_rand_base64_32
# ZOVARK_SURREAL_NS=zovark
# ZOVARK_SURREAL_DB=core
# ZOVARK_REDPANDA_ENABLED=true
# ZOVARK_REDPANDA_BROKERS=redpanda:9092
# ZOVARK_REDPANDA_TOPIC_INVESTIGATIONS=zovark.investigations.completed
# ZOVARK_DUCKDB_ENABLED=true
# ZOVARK_DUCKDB_PATH=/data/duckdb/analytics.duckdb


# ─── OPTIONAL: MINIO (object storage profile) ───────────────
# MINIO_ROOT_PASSWORD=REPLACE_ME_openssl_rand_base64_32


# ─── OPTIONAL: NATS (legacy optional overlay) ───────────────
# NATS_USER=zovark
# NATS_PASSWORD=REPLACE_ME_openssl_rand_base64_32


# ─── OPTIONAL: LITELLM GATEWAY (optional overlay) ──────────
# LITELLM_MASTER_KEY=REPLACE_ME_sk-litellm-master
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=


# ─── OPTIONAL: CUSTOMER COLLECTION + PLATFORM INGEST ────────
# ZOVARK_COLLECTION_ENABLED=true
# ZOVARK_PLATFORM_ENDPOINT=https://your-platform.example/api/v1/platform/training-data/ingest
# ZOVARK_PLATFORM_API_KEY=REPLACE_ME_shared_bearer_secret
# ZOVARK_PLATFORM_HOST=api
# ZOVARK_PLATFORM_PORT=8090
# ZOVARK_PLATFORM_URI=/api/v1/platform/training-data/ingest
# ZOVARK_PLATFORM_TLS=off
# ZOVARK_CUSTOMER_ID=00000000-0000-0000-0000-000000000001
# ZOVARK_PLATFORM_INGEST_BEARER=REPLACE_ME_same_as_ZOVARK_PLATFORM_API_KEY
# ZOVARK_COLLECTION_ANONYMIZATION_KEY=REPLACE_ME_openssl_rand_hex_32


# ─── INFRASTRUCTURE (usually left as defaults) ─────────────
TEMPORAL_ADDRESS=temporal:7233
# DATABASE_URL and REDIS_URL are constructed by compose from above values.
