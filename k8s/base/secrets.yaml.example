apiVersion: v1
kind: Secret
metadata:
  name: zovark-db-credentials
  namespace: zovark
  labels:
    app: zovark
type: Opaque
stringData:
  password: "CHANGE_ME"
  pgbouncer-url: "postgresql://zovark:CHANGE_ME@pgbouncer:5432/zovark"
  direct-url: "postgresql://zovark:CHANGE_ME@postgres:5432/zovark"
---
apiVersion: v1
kind: Secret
metadata:
  name: zovark-api-secrets
  namespace: zovark
  labels:
    app: zovark
type: Opaque
stringData:
  jwt-secret: "CHANGE_ME"
  litellm-master-key: "CHANGE_ME"
  openrouter-api-key: "CHANGE_ME"
---
# stabilize-runtime-hygiene (2026-04-15): worker Redis DSN secret.
# Consumed by k8s/base/worker/deployment.yaml via secretKeyRef.
# Expected DSN shape: redis://:<password>@<host>:<port>/<db>
apiVersion: v1
kind: Secret
metadata:
  name: zovark-worker-secrets
  namespace: zovark
  labels:
    app: zovark
type: Opaque
stringData:
  redis-url: "redis://:CHANGE_ME@redis:6379/0"
